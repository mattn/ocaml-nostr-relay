opam-version: "2.0"
synopsis: "A Nostr relay server written in OCaml"
maintainer: "Yasuhiro Matsumoto"
authors: "Yasuhiro Matsumoto"
license: "MIT"
homepage: "https://github.com/mattn/ocaml-nostr-relay"
bug-reports: "https://github.com/mattn/ocaml-nostr-relay/issues"
dev-repo: "git+https://github.com/mattn/ocaml-nostr-relay.git"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "dream" {>= "1.0.0~alpha6"}
  "yojson" {>= "2.0.0"}
  "digestif" {>= "1.1.0"}
  "postgresql" {>= "5.0.0"}
  "lwt" {>= "5.6.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
